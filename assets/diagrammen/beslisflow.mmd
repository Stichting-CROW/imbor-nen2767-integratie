flowchart TD
    A["NEN 2767-4-concept<br/>(bouwdeel / element / beheerobject)"] --> S1

    subgraph STAP1["Stap 1 — Concept op IMBOR leggen"]
        direction TB
        S1{"Ruimtelijk<br/>of reëel?"}
        S2{"Functioneel<br/>of technisch?"}
        S3{"Bestaat al<br/>in IMBOR?"}
        OPEN1["Onbepaald:<br/>onder FysiekObject,<br/>noteer als open vraag (U3)"]
        MAP["Betekenisrelatie vastgelegd<br/>(exact / narrow / broad /<br/>close / geen tegenhanger)"]
        S1 -->|"reëel of ruimtelijk"| S2
        S1 -.->|"twijfel (U3)"| OPEN1
        S2 -->|"functioneel of technisch"| S3
        S2 -.->|"twijfel (U3)"| OPEN1
        OPEN1 -.-> S3
        S3 --> MAP
    end

    MAP --> DIAG

    subgraph STAP2X["Stap 2 — Decompositie vergelijken (diagnose)"]
        direction TB
        DIAG["Inventariseer per concept en per relatie de wrijving:<br/>• niveau ≠ dimensie<br/>• dimensieconflict NEN vs IMBOR<br/>• specialisatie verkleed als hasPart<br/>(of: geen wrijving)"]
    end

    DIAG --> C

    subgraph STAP3C["Stap 3a — Uitkomst per concept"]
        direction TB
        C{"Welke<br/>uitkomst?"}
        C --> U1["1. Blijft klasse op niveau"]
        C --> U2["2. Verschuift van niveau"]
        C --> U3["3. Valt samen (exactMatch)"]
        C --> U4["4. Wordt verschijningsvorm"]
        C --> U5["5. Wordt materiaal (materie-tak)"]
        C --> U6["6. Splitst in meerdere klassen"]
        C --> U7["7. Vervalt"]
        ND["Naam en definitie vastleggen<br/>(NEN 2660-2 §8.4 / §8.5;<br/>bij verschijningsvorm: van de waarde)"]
        U1 --> ND
        U2 --> ND
        U3 --> ND
        U4 --> ND
        U5 --> ND
        U6 --> ND
    end

    ND --> R

    subgraph STAP3R["Stap 3b — Uitkomst per hasPart-relatie"]
        direction TB
        R{"Welke<br/>uitkomst?"}
        R --> R1["Blijft hasPart"]
        R --> R2["Wordt subClassOf"]
        R --> R3["Wordt isImplementedBy"]
        R --> R4["Wordt isBegrensdDoor / bevat"]
        R --> R5["Verlegd"]
        R --> R6["Vervalt"]
    end

    U7 --> PAY2["Vervalt: payload expliciet<br/>heralloceren of afvoeren"]
    ND --> PAY["Payload-bestemming:<br/>materiaal + gebrek<br/>blijven aan het concept"]
    R1 --> PAYR
    R2 --> PAYR
    R3 --> PAYR
    R4 --> PAYR
    R5 --> PAYR
    R6 --> PAYR
    PAYR["Belang verhuist<br/>mee met de relatie"]

