source "https://rubygems.org"

# Bootst de GitHub Pages-buildomgeving na: bevat Jekyll plus alle plugins die
# _config.yml gebruikt (remote-theme, include-cache, sitemap, feed). Zo rendert
# de lokale preview exact zoals de live site op GitHub Pages.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.x levert webrick niet meer standaard mee; `jekyll serve` heeft het nodig.
gem "webrick"
